# Public Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Never expose service-role credentials through NEXT_PUBLIC_* variables.
# Add server-only secrets only when a server-side admin API explicitly needs them.

# One-time server-side bootstrap for the first super admin
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY
BOOTSTRAP_ADMIN_EMAIL=admin@masar.gov.eg
BOOTSTRAP_ADMIN_PASSWORD=CHOOSE_A_STRONG_PASSWORD
